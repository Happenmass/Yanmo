{
  "name": "yanmo",
  "version": "1.0.0",
  "private": true,
  "description": "言墨 · 本地语音输入",
  "author": "Yanmo contributors",
  "license": "MIT",
  "main": ".electron/main.cjs",
  "scripts": {
    "build": "node scripts/build-electron.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test desktop/tests/*.test.ts",
    "test:desktop": "playwright test",
    "package:mac": "npm run build && electron-builder --mac --arm64 --dir",
    "package:mac:local": "bash scripts/package-mac-local.sh"
  },
  "build": {
    "appId": "org.yanmo.desktop",
    "afterPack": "./scripts/sign-mac-bridge.cjs",
    "productName": "言墨",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      ".electron/**",
      "web/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".build/release/YanmoBridge",
        "to": "native/YanmoBridge"
      },
      {
        "from": ".build/release/PermissionFlow_PermissionFlow.bundle",
        "to": "native/PermissionFlow_PermissionFlow.bundle"
      },
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "polish.txt",
          "prompt.txt",
          "correction-terms.txt"
        ]
      }
    ],
    "mac": {
      "extraResources": [
        {
          "from": "scripts/install-mac-update.sh",
          "to": "install-mac-update.sh"
        }
      ],
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": ".electron/Yanmo.icns",
      "minimumSystemVersion": "14.0",
      "type": "distribution",
      "identity": "Haipeng Gu (299DDXTQH5)",
      "forceCodeSigning": true,
      "signIgnore": [
        "(^|/)Contents/Resources/native/YanmoBridge$"
      ],
      "hardenedRuntime": true,
      "entitlements": "runtime/macos/entitlements.plist",
      "entitlementsInherit": "runtime/macos/entitlements.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "言墨需要录音以识别语音。默认通过本机 AcpmRuntime 识别；只有启用远程服务或在线语音识别 API 时才会通过网络发送音频。实时录音在内存中处理。",
        "NSScreenCaptureUsageDescription": "启用录音截屏后，言墨会在录音结束时截取一张屏幕画面，随文稿保存在本机。",
        "NSLocalNetworkUsageDescription": "言墨需要使用本地网络发现并连接你在同一局域网中配对的 AcpmRuntime 节点，以进行加密同步。"
      }
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "highlight.js": "11.12.0",
    "lucide-react": "1.61.0",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
