{
  "name": "yanmo",
  "version": "0.4.1",
  "private": true,
  "description": "言墨 · 本地语音输入",
  "author": "Yanmo contributors",
  "license": "MIT",
  "main": ".electron/main.cjs",
  "scripts": {
    "build": "node scripts/build-electron.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test desktop/tests/*.test.ts",
    "test:desktop": "playwright test",
    "runtime:mac": "python3 scripts/bundle-runtime.py",
    "package:mac": "npm run build && npm run runtime:mac && electron-builder --mac --arm64 --dir"
  },
  "build": {
    "appId": "org.yanmo.desktop",
    "productName": "言墨",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      ".electron/**",
      "web/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".build/release/YanmoBridge",
        "to": "native/YanmoBridge"
      },
      {
        "from": ".build/release/PermissionFlow_PermissionFlow.bundle",
        "to": "native/PermissionFlow_PermissionFlow.bundle"
      },
      {
        "from": "runtime/macos/python",
        "to": "python"
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*.py",
          "!test_*.py"
        ]
      },
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "*.py",
          "prompt.txt",
          "!test_*.py"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": ".electron/Yanmo.icns",
      "minimumSystemVersion": "14.0",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "runtime/macos/entitlements.plist",
      "entitlementsInherit": "runtime/macos/entitlements.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "言墨需要录音，将声音在本机转换为文字。音频不会上传，处理结束后删除临时录音。"
      }
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "highlight.js": "11.12.0",
    "lucide-react": "1.61.0",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
